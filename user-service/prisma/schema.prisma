generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())

  name      String
  email     String   @unique
  password  String
  birthDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}
